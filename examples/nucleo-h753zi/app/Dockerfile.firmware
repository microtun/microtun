FROM rust:1.97.1-trixie AS builder

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG FIRMWARE_PUBLIC_KEY_CACHE_KEY

ENV CARGO_TARGET_DIR=/target

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        binutils-arm-none-eabi \
        ca-certificates; \
    rm -rf /var/lib/apt/lists/*

RUN rustup target add thumbv7em-none-eabi

WORKDIR /project
COPY . .

# Build only the unsigned application payload. The application embeds the
# verification key supplied by the release client. MCUboot framing and the
# Ed25519 signature are added outside Docker using imgtool's external-signing flow.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/target \
    --mount=type=secret,id=firmware_public_key,required=true \
    set -eux; \
    public_key=/run/secrets/firmware_public_key; \
    test -n "$FIRMWARE_PUBLIC_KEY_CACHE_KEY"; \
    app_dir=/project/examples/nucleo-h753zi/app; \
    elf=/target/thumbv7em-none-eabi/release/microtun-nucleo-h753zi; \
    test -f "$public_key"; \
    mkdir -p /out; \
    cd "$app_dir"; \
    MICROTUN_FIRMWARE_PUBLIC_KEY_PEM_PATH="$public_key" MICROTUN_FIRMWARE_PUBLIC_KEY_CACHE_KEY="$FIRMWARE_PUBLIC_KEY_CACHE_KEY" cargo build --release; \
    test -s "$elf"; \
    arm-none-eabi-objcopy -O binary "$elf" /out/firmware.bin; \
    test -s /out/firmware.bin

FROM scratch AS artifact
COPY --from=builder /out/firmware.bin /firmware.bin
