# syntax=docker/dockerfile:1.7

ARG RUST_VERSION=1.97.1
ARG DEBIAN_SUITE=trixie

FROM rust:${RUST_VERSION}-${DEBIAN_SUITE} AS deb-builder

# Re-declare so the global value is visible inside this stage.
ARG RUST_VERSION

ENV DEBIAN_FRONTEND=noninteractive

# The Rust toolchain comes from the official rust image. Debian's cargo/rustc
# are deliberately not installed; dpkg-buildpackage -d below skips the
# Build-Depends check that would otherwise require them.
#
# Use the image's toolchain rather than the one named by rust-toolchain.toml,
# so the build never asks rustup to download components.
ENV RUSTUP_TOOLCHAIN=${RUST_VERSION}

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        debhelper \
        dpkg-dev \
        libfuse3-dev \
        pkg-config

WORKDIR /build/src
COPY . .

# dpkg-buildpackage writes the binary packages to /build. BuildKit caches Cargo
# downloads between builds without putting them into the package artifact.
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    dpkg-buildpackage -us -uc -b -d

FROM scratch AS debs
COPY --from=deb-builder /build/*.deb /
